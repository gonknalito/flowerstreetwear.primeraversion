# Copia este archivo como ".env" (NO lo subas a GitHub) y define las variables en el servidor donde publiques la tienda.
# Los valores de abajo son de ejemplo, no son claves reales.

# development = pagos y correos SIMULADOS, pantallas /dev/*.  production = sin simulaciones (los pagos quedan deshabilitados hasta conectar una pasarela real).
FLOWERS_ENV=development
FLOWERS_PORT=5080
# Carpeta persistente con la base de datos (flowers.db) y las fotos (uploads/). Respáldala.
FLOWERS_DATA_DIR=./data
# Carpeta del sitio público (index.html, css, js, assets). Por defecto: la carpeta superior de server/.
# FLOWERS_SITE_DIR=..
# Secreto para firmar/verificar las notificaciones del proveedor de pagos. En producción es OBLIGATORIO (mín. 32 caracteres aleatorios).
FLOWERS_WEBHOOK_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# --- Pendientes para producción (aún NO implementados; ver _interno/PUBLICAR_Y_COBRAR.md) ---
# Pasarela de pago: claves públicas/privadas del proveedor elegido.
# Correo: servidor SMTP o API del proveedor de correo.
